#!/usr/bin/osascript -l JavaScript

// Helpers
function envVar(varName) {
  return $.NSProcessInfo
    .processInfo
    .environment
    .objectForKey(varName).js
}

// Main
const ignoredFolders = envVar("ignored_folders").split("\n")
const folders = Application("com.apple.Notes").folders
const folderNames = folders.name()

const sfItems = folders().flatMap((folderReference, folderIndex) => {
  const folderName = folderNames[folderIndex]
  if (ignoredFolders.find(ignoredFolder => ignoredFolder === folderName)) return []

  const notes = folderReference.notes
  const ids = notes.id()
  const names = notes.name()
  const passwordProtecteds = notes.passwordProtected()
  const plaintexts = notes.plaintext()

  return ids.map((id, noteIndex) => {
    const name = names[noteIndex]
    const passwordProtected = passwordProtecteds[noteIndex]
    const plaintext = plaintexts[noteIndex]

    return {
      uid: id,
      title: passwordProtected ? "🔒" + name : name,
      subtitle: folderName,
      arg: id,
      match: folderName + " " + name + " " + plaintext
    }
  }
)})

// Output JSON
sfItems.length > 0 ?
  JSON.stringify({ cache: { seconds: 300, loosereload: true }, items: sfItems }) :
  JSON.stringify({ items: [{ title: "No Notes Found", subtitle: "Ensure you have not ignored all folders in the configuration", valid: false }] })
